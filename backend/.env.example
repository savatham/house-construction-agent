# =============================================================================
# Vikaspuri House Assistant — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# =============================================================================

# ── OpenAI ────────────────────────────────────────────────────────────────────
# Your OpenAI API key (starts with sk-)
OPENAI_API_KEY=sk-your-openai-key-here

# Model to use.  gpt-4o-mini is fast and cheap; change to gpt-4o for richer answers.
OPENAI_MODEL=gpt-4o-mini

# ── Google Sheets ─────────────────────────────────────────────────────────────
# Google Sheets API key (restricted to Sheets API only is recommended)
GOOGLE_SHEETS_API_KEY=your-google-sheets-api-key-here

# The ID from your Google Sheet URL:
#   https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit
GOOGLE_SHEET_ID=your-google-sheet-id-here

# ── Optional tuning ───────────────────────────────────────────────────────────
# How long (seconds) to cache sheet data before re-fetching.  Default: 300 (5 min)
SHEET_CACHE_TTL_SECONDS=300

# Rate limiting: max prompts per IP per window.  Default: 20 per 15 minutes
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_SECONDS=900

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000

# Set to "true" only during local development — never in production
FLASK_DEBUG=false
